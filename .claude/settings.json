{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/lua-lint.sh",
            "timeout": 30,
            "statusMessage": "Linting Lua"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/pre-commit-tests.sh",
            "timeout": 120,
            "statusMessage": "Testing before commit"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/pre-release-tag.sh",
            "timeout": 30,
            "statusMessage": "Checking OpenSpec before a release tag"
          }
        ]
      }
    ]
  }
}
